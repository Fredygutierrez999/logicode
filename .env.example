# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a git.

# --- Opción A (producción en GoDaddy): API de Resend por HTTPS ---
# GoDaddy bloquea las conexiones SMTP salientes; con esta clave el formulario
# envía por la API de Resend (https://resend.com). Tiene prioridad sobre SMTP.
# RESEND_API_KEY=re_...
# Remitente. Sin dominio verificado se usa onboarding@resend.dev (solo pruebas).
# Tras verificar logicode.app en Resend:
# EMAIL_FROM=Logi Code <contacto@logicode.app>

# --- Opción B (desarrollo local): SMTP de Gmail ---
# Cuenta de Gmail que envía los correos del formulario de contacto.
SMTP_USER=logi.code.app@gmail.com

# Contraseña de aplicación de Google (16 caracteres, sin espacios).
# NO es la contraseña normal de la cuenta. Créala en:
# https://myaccount.google.com/apppasswords  (requiere verificación en 2 pasos)
SMTP_PASS=

# Dominio público del sitio, SIN barra final. Por defecto https://logicode.app
# (ver src/lib/site.ts). Solo hace falta si el dominio cambia.
# SITE_URL=https://logicode.app

# Clave para el diagnóstico del correo (/api/diagnostico-correo?token=...).
# Sin esta variable la página responde 404. Usa un valor largo y aleatorio,
# p. ej. el resultado de: openssl rand -hex 24   (ver README).
# DIAG_TOKEN=

# Opcionales
# CONTACT_TO=logi.code.app@gmail.com   # destinatario (por defecto el de src/lib/site.ts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
