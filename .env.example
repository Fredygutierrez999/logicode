# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a git.

# Cuenta de Gmail que envía los correos del formulario de contacto.
SMTP_USER=logi.code.app@gmail.com

# Contraseña de aplicación de Google (16 caracteres, sin espacios).
# NO es la contraseña normal de la cuenta. Créala en:
# https://myaccount.google.com/apppasswords  (requiere verificación en 2 pasos)
SMTP_PASS=

# Dominio público del sitio, SIN barra final. Por defecto https://logicode.app
# (ver src/lib/site.ts). Solo hace falta si el dominio cambia.
# SITE_URL=https://logicode.app

# Opcionales
# CONTACT_TO=logi.code.app@gmail.com   # destinatario (por defecto el de src/lib/site.ts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
